[Unit]
Description=Mediamtx Monitoring API (FastAPI)
# Ordering only: the API derives the preview base from MediaMTX at startup.
# No Wants=/Requires=, so the monitor neither starts nor owns mediamtx.service.
After=network.target redis-server.service mediamtx.service
Requires=redis-server.service

[Service]
User=mediamtxmon
Group=mediamtxmon
WorkingDirectory=/opt/mediamtx-monitoring-backend
ExecStart=/opt/mediamtx-monitoring-backend/venv/bin/python3 bin/monitoring_api.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
