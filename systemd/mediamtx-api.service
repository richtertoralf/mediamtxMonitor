[Unit]
Description=Mediamtx Monitoring API (FastAPI)
# Ordering only: the API derives the preview base from MediaMTX at startup.
# No Wants=/Requires= on mediamtx.service: the monitor neither starts nor owns it.
After=network.target redis-server.service mediamtx.service
# Wants=, not Requires=: stopping redis-server must not stop this service;
# it keeps running and reconnects when Redis is back.
Wants=redis-server.service

[Service]
User=mediamtxmon
Group=mediamtxmon
WorkingDirectory=/opt/mediamtx-monitoring-backend
ExecStart=/opt/mediamtx-monitoring-backend/venv/bin/python3 bin/monitoring_api.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
