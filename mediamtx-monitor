#!/usr/bin/env bash
set -euo pipefail

readonly DEFAULT_INSTALL_DIR="/opt/mediamtx-monitoring-backend"
readonly INSTALL_DIR="${MEDIAMTX_MONITOR_INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
readonly DEFAULT_CLI_PATH="/usr/local/bin/mediamtx-monitor"
readonly CLI_PATH="${MEDIAMTX_MONITOR_CLI_PATH:-$DEFAULT_CLI_PATH}"
readonly DEFAULT_SERVICE_DIR="/etc/systemd/system"
readonly SERVICE_DIR="${MEDIAMTX_MONITOR_SERVICE_DIR:-$DEFAULT_SERVICE_DIR}"
readonly REPOSITORY_URL="${MEDIAMTX_MONITOR_REPOSITORY_URL:-https://github.com/richtertoralf/mediamtxMonitor.git}"
readonly SERVICE_USER="${MEDIAMTX_MONITOR_SERVICE_USER:-mediamtxmon}"
readonly LEGACY_SERVICE="mediamtx-systeminfo.service"
readonly LEGACY_PROGRAM_FILE="$INSTALL_DIR/bin/mediamtx_systeminfo.py"
LEGACY_UNIT_REMOVED=0

readonly SERVICES=(
  mediamtx-api.service
  mediamtx-collector.service
  mediamtx-system.service
)

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'Usage: mediamtx-monitor --version | --status | --upgrade | --check-config [FILE]\n' >&2
}

read_version() {
  local version_file=$1
  local version

  [ -r "$version_file" ] || fail "Version file is missing or unreadable: $version_file"
  IFS= read -r version < "$version_file" || true
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
    fail "Invalid version in $version_file"
  printf '%s' "$version"
}

# The installed commit; empty when unknown (installations before REVISION).
read_revision() {
  local revision_file=$1
  local revision=""

  if [ -r "$revision_file" ]; then
    IFS= read -r revision < "$revision_file" || true
  fi
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] && printf '%s' "$revision"
  return 0
}

describe_revision() {
  if [ -n "$1" ]; then
    printf '%s' "${1:0:7}"
  else
    printf 'unknown commit'
  fi
}

require_upgrade_commands() {
  local command_name
  for command_name in git python3 rsync systemctl; do
    command -v "$command_name" >/dev/null 2>&1 || fail "Required command is missing: $command_name"
  done
}

# Programmbestandteile, die ein Upgrade austauscht. config/ (Betreiberdatei)
# und .cache/ (pip-Cache des Dienstkontos) bleiben unberührt.
readonly RUNTIME_ITEMS=(bin static venv requirements.txt VERSION REVISION)
TEMP_DIR=""
STAGING_DIR=""
BACKUP_DIR=""
SWAP_STARTED=0
SERVICES_RESTARTED=0
UPGRADE_DONE=0
ACTIVE_SERVICES=()

# Neue Laufzeit getrennt von der Installation bauen: Programmdateien, eigene
# venv mit den Abhängigkeiten, VERSION und REVISION.
build_runtime() {
  local source_dir=$1 revision=$2 venv_script
  STAGING_DIR=$(mktemp -d "$INSTALL_DIR.upgrade-XXXXXX")
  chmod 0755 "$STAGING_DIR"
  rsync -rl --exclude='__pycache__/' --exclude='*.pyc' "$source_dir/bin/" "$STAGING_DIR/bin/"
  rsync -rl "$source_dir/static/" "$STAGING_DIR/static/"
  install -m 0644 "$source_dir/requirements.txt" "$STAGING_DIR/requirements.txt"
  install -m 0644 "$source_dir/VERSION" "$STAGING_DIR/VERSION"
  printf '%s\n' "$revision" > "$STAGING_DIR/REVISION"
  if [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ]; then
    command -v runuser >/dev/null 2>&1 || fail "Required command is missing: runuser"
    chown -R "$SERVICE_USER:$SERVICE_USER" "$STAGING_DIR"
    runuser -u "$SERVICE_USER" -- env HOME="$INSTALL_DIR" python3 -m venv "$STAGING_DIR/venv"
    runuser -u "$SERVICE_USER" -- env HOME="$INSTALL_DIR" "$STAGING_DIR/venv/bin/python" -m pip install \
      --disable-pip-version-check -r "$STAGING_DIR/requirements.txt"
  else
    python3 -m venv "$STAGING_DIR/venv"
    "$STAGING_DIR/venv/bin/python" -m pip install --disable-pip-version-check -r "$STAGING_DIR/requirements.txt"
  fi
  # Startskripte der venv auf den endgültigen Ort umstellen.
  { grep -Il -- "$STAGING_DIR/venv" "$STAGING_DIR"/venv/bin/* 2>/dev/null || true; } | while IFS= read -r venv_script; do
    sed -i "s|$STAGING_DIR/venv|$INSTALL_DIR/venv|g" "$venv_script"
  done
  if [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ]; then
    chown -R "$SERVICE_USER:$SERVICE_USER" "$STAGING_DIR"
  fi
}

# Vor dem Austausch: Abhängigkeiten, Python-Syntax und die vorhandene
# Betreiberkonfiguration mit dem neuen Code prüfen (lesend).
check_runtime() {
  "$STAGING_DIR/venv/bin/python" -m pip check || fail "Python dependencies of the new runtime are inconsistent"
  PYTHONPYCACHEPREFIX="$STAGING_DIR/.pycache-check" "$STAGING_DIR/venv/bin/python" -m compileall -q \
    "$STAGING_DIR/bin" || fail "New program files do not compile"
  rm -rf -- "$STAGING_DIR/.pycache-check"
  "$STAGING_DIR/venv/bin/python" "$STAGING_DIR/bin/config_check.py" --standard \
    "$INSTALL_DIR/config/collector.yaml" >/dev/null || \
    fail "Existing configuration does not fit the new version: mediamtx-monitor --check-config"
}

capture_service_states() {
  local service active enabled
  ACTIVE_SERVICES=()
  for service in "${SERVICES[@]}"; do
    active=$(systemctl is-active "$service" 2>/dev/null || true)
    enabled=$(systemctl is-enabled "$service" 2>/dev/null || true)
    printf '%-28s %s, %s\n' "$service" "${active:-unknown}" "${enabled:-unknown}"
    [ "$active" != active ] || ACTIVE_SERVICES+=("$service")
  done
}

# Autostart wird nie geändert; neu gestartet werden nur vorher aktive Dienste.
restart_active_services() {
  [ "${#ACTIVE_SERVICES[@]}" -gt 0 ] || return 0
  SERVICES_RESTARTED=1
  systemctl restart "${ACTIVE_SERVICES[@]}"
}

swap_runtime() {
  local source_dir=$1 item service
  BACKUP_DIR=$(mktemp -d "$INSTALL_DIR.rollback-XXXXXX")
  mkdir "$BACKUP_DIR/units"
  for service in "${SERVICES[@]}"; do
    [ ! -f "$SERVICE_DIR/$service" ] || cp -p -- "$SERVICE_DIR/$service" "$BACKUP_DIR/units/"
  done
  SWAP_STARTED=1
  for item in "${RUNTIME_ITEMS[@]}"; do
    [ ! -e "$INSTALL_DIR/$item" ] || mv -- "$INSTALL_DIR/$item" "$BACKUP_DIR/$item"
    mv -- "$STAGING_DIR/$item" "$INSTALL_DIR/$item"
  done
  install_monitor_units "$source_dir"
  systemctl daemon-reload || fail "Failed to reload systemd units"
  [ "${MEDIAMTX_MONITOR_TEST_FAIL_AFTER_SWAP:-0}" != 1 ] || fail "Simulated failure after swap (test)"
}

rollback_runtime() {
  local item service
  set +e
  printf 'Rollback: restoring the previous runtime.\n' >&2
  for item in "${RUNTIME_ITEMS[@]}"; do
    rm -rf -- "${INSTALL_DIR:?}/$item"
    [ ! -e "$BACKUP_DIR/$item" ] || mv -- "$BACKUP_DIR/$item" "$INSTALL_DIR/$item"
  done
  for service in "${SERVICES[@]}"; do
    if [ -f "$BACKUP_DIR/units/$service" ]; then
      cp -p -- "$BACKUP_DIR/units/$service" "$SERVICE_DIR/$service"
    else
      rm -f -- "$SERVICE_DIR/$service"
    fi
  done
  systemctl daemon-reload
  # Nur wenn die neue Laufzeit schon gestartet wurde, laufen die vorher aktiven
  # Dienste wieder mit der alten; gestoppte Dienste bleiben gestoppt.
  if [ "$SERVICES_RESTARTED" -eq 1 ]; then
    systemctl restart "${ACTIVE_SERVICES[@]}"
  fi
  set -e
}

upgrade_cleanup() {
  local status=$? path
  if [ "$status" -ne 0 ] && [ "$SWAP_STARTED" -eq 1 ] && [ "$UPGRADE_DONE" -eq 0 ]; then
    rollback_runtime
  fi
  for path in "$TEMP_DIR" "$STAGING_DIR" "$BACKUP_DIR"; do
    if [ -n "$path" ] && [ -d "$path" ]; then rm -rf -- "$path"; fi
  done
  exit "$status"
}

install_cli() {
  local source_file=$1

  if [ "$CLI_PATH" = "$DEFAULT_CLI_PATH" ]; then
    install -o root -g root -m 0755 "$source_file" "$CLI_PATH"
  else
    install -m 0755 "$source_file" "$CLI_PATH"
  fi
}

install_monitor_units() {
  local source_dir=$1
  local service

  for service in "${SERVICES[@]}"; do
    install -m 0644 "$source_dir/systemd/$service" "$SERVICE_DIR/$service" || \
      fail "Failed to install systemd unit: $service"
  done
}

remove_legacy_system_monitor() {
  local legacy_unit="$SERVICE_DIR/$LEGACY_SERVICE" legacy_listing

  legacy_listing=$(systemctl list-unit-files "$LEGACY_SERVICE" --no-legend 2>/dev/null || true)
  if [ -n "$legacy_listing" ] || [ -e "$legacy_unit" ] || [ -L "$legacy_unit" ]; then
    printf 'Removing legacy service %s...\n' "$LEGACY_SERVICE"
    systemctl disable --now "$LEGACY_SERVICE" || \
      fail "Failed to stop and disable legacy service: $LEGACY_SERVICE"
    rm -f -- "$legacy_unit" || fail "Failed to remove legacy systemd unit: $legacy_unit"
    LEGACY_UNIT_REMOVED=1
  fi

  if [ -e "$LEGACY_PROGRAM_FILE" ] || [ -L "$LEGACY_PROGRAM_FILE" ]; then
    printf 'Removing legacy file bin/mediamtx_systeminfo.py...\n'
    rm -f -- "$LEGACY_PROGRAM_FILE" || \
      fail "Failed to remove legacy program file: $LEGACY_PROGRAM_FILE"
  fi
}

upgrade() {
  local source_dir installed_version available_version service status
  local installed_revision available_revision

  [ -d "$INSTALL_DIR" ] || {
    printf 'No existing MediaMTX Monitor installation found.\n' >&2
    printf 'Run install.sh first.\n' >&2
    exit 1
  }
  [ "$INSTALL_DIR" != "$DEFAULT_INSTALL_DIR" ] || [ "${EUID:-$(id -u)}" -eq 0 ] || \
    fail "Root privileges are required. Run: sudo mediamtx-monitor --upgrade"

  installed_version=$(read_version "$INSTALL_DIR/VERSION")
  installed_revision=$(read_revision "$INSTALL_DIR/REVISION")
  require_upgrade_commands

  TEMP_DIR=$(mktemp -d)
  trap upgrade_cleanup EXIT
  source_dir="$TEMP_DIR/repository"

  printf 'Downloading...\n'
  git clone --depth 1 "$REPOSITORY_URL" "$source_dir" >/dev/null
  available_version=$(read_version "$source_dir/VERSION")
  available_revision=$(git -C "$source_dir" rev-parse HEAD) || \
    fail "Downloaded commit could not be determined"
  [[ "$available_revision" =~ ^[0-9a-f]{40}$ ]] || \
    fail "Invalid downloaded commit: $available_revision"

  printf 'Installed: %s (%s)\n' "$installed_version" "$(describe_revision "$installed_revision")"
  printf 'Available: %s (%s)\n\n' "$available_version" "$(describe_revision "$available_revision")"
  for source_path in bin static requirements.txt mediamtx-monitor; do
    [ -e "$source_dir/$source_path" ] || fail "Downloaded repository is incomplete: $source_path"
  done
  for service in "${SERVICES[@]}"; do
    [ -r "$source_dir/systemd/$service" ] || \
      fail "Downloaded repository is incomplete: systemd/$service"
  done

  remove_legacy_system_monitor
  # Version and commit must both match; a merge without a version bump still
  # updates, and an installation with unknown commit is updated once.
  if [ "$installed_version" = "$available_version" ] && \
     [ "$installed_revision" = "$available_revision" ]; then
    if [ "$LEGACY_UNIT_REMOVED" -eq 1 ]; then
      systemctl daemon-reload || fail "Failed to reload systemd units"
    fi
    printf 'MediaMTX Monitor is already up to date: %s (%s)\n' \
      "$installed_version" "$(describe_revision "$installed_revision")"
    return 0
  fi

  # MediaMTX selbst wird nie installiert, geändert oder neu gestartet.
  printf 'Service states before upgrade:\n'
  capture_service_states
  printf '\nBuilding new runtime...\n'
  build_runtime "$source_dir" "$available_revision"
  printf 'Checking new runtime...\n'
  check_runtime
  printf 'Replacing runtime and systemd units...\n'
  swap_runtime "$source_dir"
  printf 'Restarting previously active services...\n'
  restart_active_services || fail "Failed to restart monitor services"
  printf '\n'
  for service in "${SERVICES[@]}"; do
    if [[ " ${ACTIVE_SERVICES[*]} " != *" $service "* ]]; then
      printf '%-20s %s\n' "${service%.service}" "not started (was not active)"
    elif status=$(systemctl is-active "$service"); then
      printf '%-20s %s\n' "${service%.service}" "$status"
    else
      printf '%-20s %s\n' "${service%.service}" "${status:-failed}" >&2
      fail "Service is not active after upgrade: $service"
    fi
  done
  UPGRADE_DONE=1
  install_cli "$source_dir/mediamtx-monitor"

  printf '\nUpgrade complete: %s (%s) -> %s (%s)\n' \
    "$installed_version" "$(describe_revision "$installed_revision")" \
    "$available_version" "$(describe_revision "$available_revision")"
}

show_version() {
  local version revision

  version=$(read_version "$INSTALL_DIR/VERSION")
  revision=$(read_revision "$INSTALL_DIR/REVISION")
  if [ -n "$revision" ]; then
    printf 'MediaMTX Monitor %s (%s)\n' "$version" "${revision:0:7}"
  else
    printf 'MediaMTX Monitor %s\n' "$version"
  fi
}

check_config() {
  local python_bin="$INSTALL_DIR/venv/bin/python"

  [ -x "$python_bin" ] || fail "Existing Python environment is missing: $python_bin"
  # Read-only: no Redis, network, service, or file changes. Without FILE the
  # check uses the installed configuration.
  if [ "$#" -eq 1 ]; then
    exec "$python_bin" "$INSTALL_DIR/bin/config_check.py" "$1"
  fi
  exec "$python_bin" "$INSTALL_DIR/bin/config_check.py" --standard "$INSTALL_DIR/config/collector.yaml"
}

show_status() {
  local python_bin="$INSTALL_DIR/venv/bin/python"

  [ -x "$python_bin" ] || fail "Existing Python environment is missing: $python_bin"
  # Read-only: is the monitor running, is its data current, where is the dashboard?
  exec "$python_bin" "$INSTALL_DIR/bin/monitor_status.py" "$INSTALL_DIR/config/collector.yaml"
}

main() {
  if [ "$#" -eq 2 ] && [ "$1" = --check-config ]; then
    check_config "$2"
  fi
  if [ "$#" -ne 1 ]; then
    usage
    exit 2
  fi

  case "$1" in
    --check-config)
      check_config
      ;;
    --status)
      show_status
      ;;
    --version)
      show_version
      ;;
    --upgrade)
      upgrade
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
