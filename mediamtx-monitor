#!/usr/bin/env bash
set -euo pipefail

readonly DEFAULT_INSTALL_DIR="/opt/mediamtx-monitoring-backend"
readonly INSTALL_DIR="${MEDIAMTX_MONITOR_INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
readonly DEFAULT_CLI_PATH="/usr/local/bin/mediamtx-monitor"
readonly CLI_PATH="${MEDIAMTX_MONITOR_CLI_PATH:-$DEFAULT_CLI_PATH}"
readonly DEFAULT_SERVICE_DIR="/etc/systemd/system"
readonly SERVICE_DIR="${MEDIAMTX_MONITOR_SERVICE_DIR:-$DEFAULT_SERVICE_DIR}"
readonly REPOSITORY_URL="${MEDIAMTX_MONITOR_REPOSITORY_URL:-https://github.com/richtertoralf/mediamtxMonitor.git}"
readonly SERVICE_USER="${MEDIAMTX_MONITOR_SERVICE_USER:-mediamtxmon}"
readonly LEGACY_SERVICE="mediamtx-systeminfo.service"
readonly LEGACY_PROGRAM_FILE="$INSTALL_DIR/bin/mediamtx_systeminfo.py"
LEGACY_UNIT_REMOVED=0

readonly SERVICES=(
  mediamtx-api.service
  mediamtx-collector.service
  mediamtx-system.service
)

fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'Usage: mediamtx-monitor --version | --upgrade\n' >&2
}

read_version() {
  local version_file=$1
  local version

  [ -r "$version_file" ] || fail "Version file is missing or unreadable: $version_file"
  IFS= read -r version < "$version_file" || true
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
    fail "Invalid version in $version_file"
  printf '%s' "$version"
}

require_upgrade_commands() {
  local command_name
  for command_name in git rsync systemctl; do
    command -v "$command_name" >/dev/null 2>&1 || fail "Required command is missing: $command_name"
  done
}

upgrade_dependencies() {
  local requirements_file="$INSTALL_DIR/requirements.txt"
  local python_bin="$INSTALL_DIR/venv/bin/python"

  [ -x "$python_bin" ] || fail "Existing Python environment is missing: $python_bin"
  if [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ]; then
    command -v runuser >/dev/null 2>&1 || fail "Required command is missing: runuser"
    runuser -u "$SERVICE_USER" -- env HOME="$INSTALL_DIR" "$python_bin" -m pip install \
      --disable-pip-version-check \
      --upgrade \
      -r "$requirements_file"
  else
    "$python_bin" -m pip install --disable-pip-version-check --upgrade -r "$requirements_file"
  fi
}

install_application_file() {
  local source_file=$1
  local destination_file=$2

  if [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ]; then
    install -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0644 "$source_file" "$destination_file"
  else
    install -m 0644 "$source_file" "$destination_file"
  fi
}

install_cli() {
  local source_file=$1

  if [ "$CLI_PATH" = "$DEFAULT_CLI_PATH" ]; then
    install -o root -g root -m 0755 "$source_file" "$CLI_PATH"
  else
    install -m 0755 "$source_file" "$CLI_PATH"
  fi
}

install_monitor_units() {
  local source_dir=$1
  local service

  for service in "${SERVICES[@]}"; do
    install -m 0644 "$source_dir/systemd/$service" "$SERVICE_DIR/$service" || \
      fail "Failed to install systemd unit: $service"
  done
}

remove_legacy_system_monitor() {
  local legacy_unit="$SERVICE_DIR/$LEGACY_SERVICE" legacy_listing

  legacy_listing=$(systemctl list-unit-files "$LEGACY_SERVICE" --no-legend 2>/dev/null || true)
  if [ -n "$legacy_listing" ] || [ -e "$legacy_unit" ] || [ -L "$legacy_unit" ]; then
    printf 'Removing legacy service %s...\n' "$LEGACY_SERVICE"
    systemctl disable --now "$LEGACY_SERVICE" || \
      fail "Failed to stop and disable legacy service: $LEGACY_SERVICE"
    rm -f -- "$legacy_unit" || fail "Failed to remove legacy systemd unit: $legacy_unit"
    LEGACY_UNIT_REMOVED=1
  fi

  if [ -e "$LEGACY_PROGRAM_FILE" ] || [ -L "$LEGACY_PROGRAM_FILE" ]; then
    printf 'Removing legacy file bin/mediamtx_systeminfo.py...\n'
    rm -f -- "$LEGACY_PROGRAM_FILE" || \
      fail "Failed to remove legacy program file: $LEGACY_PROGRAM_FILE"
  fi
}

upgrade() {
  local temp_dir source_dir installed_version available_version service status

  [ -d "$INSTALL_DIR" ] || {
    printf 'No existing MediaMTX Monitor installation found.\n' >&2
    printf 'Run install.sh first.\n' >&2
    exit 1
  }
  [ "$INSTALL_DIR" != "$DEFAULT_INSTALL_DIR" ] || [ "${EUID:-$(id -u)}" -eq 0 ] || \
    fail "Root privileges are required. Run: sudo mediamtx-monitor --upgrade"

  installed_version=$(read_version "$INSTALL_DIR/VERSION")
  require_upgrade_commands

  temp_dir=$(mktemp -d)
  trap "rm -rf -- '$temp_dir'" EXIT
  source_dir="$temp_dir/repository"

  printf 'Downloading...\n'
  git clone --depth 1 "$REPOSITORY_URL" "$source_dir" >/dev/null
  available_version=$(read_version "$source_dir/VERSION")

  printf 'Installed: %s\n' "$installed_version"
  printf 'Available: %s\n\n' "$available_version"
  for source_path in bin static requirements.txt mediamtx-monitor; do
    [ -e "$source_dir/$source_path" ] || fail "Downloaded repository is incomplete: $source_path"
  done
  for service in "${SERVICES[@]}"; do
    [ -r "$source_dir/systemd/$service" ] || \
      fail "Downloaded repository is incomplete: systemd/$service"
  done

  remove_legacy_system_monitor
  if [ "$installed_version" = "$available_version" ]; then
    if [ "$LEGACY_UNIT_REMOVED" -eq 1 ]; then
      systemctl daemon-reload || fail "Failed to reload systemd units"
    fi
    printf 'MediaMTX Monitor is already up to date: %s\n' "$installed_version"
    return 0
  fi

  printf 'Updating application...\n'
  rsync -rl --delete --exclude='__pycache__/' --exclude='*.pyc' \
    "$source_dir/bin/" "$INSTALL_DIR/bin/"
  rsync -rl --delete "$source_dir/static/" "$INSTALL_DIR/static/"
  install_application_file "$source_dir/requirements.txt" "$INSTALL_DIR/requirements.txt"
  install_cli "$source_dir/mediamtx-monitor"

  printf 'Updating Python dependencies...\n'
  upgrade_dependencies
  install_application_file "$source_dir/VERSION" "$INSTALL_DIR/VERSION"
  if [ "$INSTALL_DIR" = "$DEFAULT_INSTALL_DIR" ]; then
    chown -R "$SERVICE_USER:$SERVICE_USER" "$INSTALL_DIR/bin" "$INSTALL_DIR/static"
  fi

  printf 'Updating systemd units...\n'
  install_monitor_units "$source_dir"
  systemctl daemon-reload || fail "Failed to reload systemd units"

  printf 'Restarting services...\n'
  systemctl restart "${SERVICES[@]}" || fail "Failed to restart monitor services"
  printf '\n'
  for service in "${SERVICES[@]}"; do
    if status=$(systemctl is-active "$service"); then
      printf '%-20s %s\n' "${service%.service}" "$status"
    else
      printf '%-20s %s\n' "${service%.service}" "${status:-failed}" >&2
      fail "Service is not active after upgrade: $service"
    fi
  done

  printf '\nUpgrade complete: %s -> %s\n' "$installed_version" "$available_version"
}

main() {
  if [ "$#" -ne 1 ]; then
    usage
    exit 2
  fi

  case "$1" in
    --version)
      printf 'MediaMTX Monitor %s\n' "$(read_version "$INSTALL_DIR/VERSION")"
      ;;
    --upgrade)
      upgrade
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      usage
      exit 2
      ;;
  esac
}

main "$@"
